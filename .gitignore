# Secrets — the Stratz API key lives in .env and must never be committed.
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Runtime data: API caches, captured frames, debug output, downloaded assets.
data_cache/
captures/
debug_out/
assets/portraits/
assets/items/
assets/synth/
assets/gate/
assets/role_icons/
# SCREENSHOTS OF THE GAME ARE VALVE'S ARTWORK, like everything above.
# This folder is where the resolution sweep is pointed, so it fills up
# with full-screen captures of the draft - and it was the one artwork
# folder NOT listed here, which is the way that rule gets broken by
# accident rather than by decision. A frame also shows whatever else was
# on screen and the player names in the game, so it carries more than
# the artwork does.
assets/screenshots/
# The app icon: whatever the user chose, and the .ico written
# from it for the shortcut and the taskbar pin.
assets/app.ico
assets/app.png
assets/app.jpg
assets/app.jpeg
assets/app.bmp
assets/app-generated.ico
calibration_local.json

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/
ui_settings.json
preferences.json
# Which accounts the match history analyser has looked at. Local only, so
# a copy of this app carries nobody's account numbers or results.
history_accounts.json
# Workbooks the analyser exported.
history_reports/

# Recording sessions: payloads, frames and state logs from real games.
recordings/

# Which release this install is on, written by tools/update_app.py when a
# downloaded copy updates itself. It describes THIS machine, not the app.
installed_version.json

# The last run for each account the analyser has measured. Local only,
# beside history_accounts.json: a copy of this app carries nobody else's
# match history.
history_cache/
